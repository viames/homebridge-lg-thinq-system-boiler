{
  "pluginAlias": "LGThinQSystemBoiler",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "headerDisplay": "Connect compatible LG system boilers through the LG ThinQ cloud API. Use the country of your LG account and a Personal Access Token with device-list, device-status and device-control permissions.",
  "schema": {
    "type": "object",
    "required": ["name", "country", "accessToken"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "LG ThinQ System Boiler"
      },
      "country": {
        "title": "LG account country",
        "type": "string",
        "default": "IT",
        "minLength": 2,
        "maxLength": 2
      },
      "accessToken": {
        "title": "ThinQ Personal Access Token",
        "type": "string",
        "x-schema-form": {
          "type": "password"
        }
      },
      "refreshInterval": {
        "title": "Refresh interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 30,
        "maximum": 600
      }
    }
  }
}

